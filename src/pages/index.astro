---
import '../styles/redrobot-original.css';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>REDRobot Educación Digital</title>
  <meta name="description" content="Robótica, programación y pensamiento creativo para estudiantes, docentes e instituciones." />
  <link rel="icon" href="/assets/favicon-redrobot.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet" />
</head>
<body><main><a class="skip-link" href="#contenido">Saltar al contenido</a><header class="site-header"><a class="brand" href="#inicio" aria-label="REDRobot, inicio"><img class="animated-logo" src="/assets/redrobot-logo-animado-claro.webp" alt="REDRobot" width="190" height="38" loading="eager" decoding="async"/></a><nav aria-label="Navegación principal"><a href="#proyecto">Qué es</a><a href="#propuestas">Propuestas</a><a href="#instituciones">Instituciones</a><a href="#plataforma">Plataforma</a></nav><div class="header-actions"><div class="social-links" aria-label="Redes sociales"><a href="https://www.instagram.com/redrobot.educacion/" target="_blank" rel="noreferrer" aria-label="REDRobot en Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle><circle class="social-dot" cx="17.4" cy="6.7" r="1"></circle></svg></a><a href="https://www.facebook.com/redrobot.educacion/" target="_blank" rel="noreferrer" aria-label="REDRobot en Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.2 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H8V13h2.8v8h3.4Z"></path></svg></a></div><a class="button button-small" href="https://wa.me/541140488933?text=Hola%2C%20quisiera%20recibir%20informaci%C3%B3n%20sobre%20las%20propuestas%20educativas%20de%20REDRobot." target="_blank" rel="noreferrer">Consultanos <span aria-hidden="true">↗</span></a></div></header><section class="hero" id="inicio" aria-labelledby="contenido"><div class="hero-copy"><p class="eyebrow"><span></span> Educación STEAM para todos los niveles</p><h1 id="contenido">Tecnología educativa para <em>aprender haciendo.</em></h1><p class="hero-intro"><span class="inline-brand" aria-label="REDRobot"><strong>RED</strong><span>Robot</span></span> crea talleres, formación docente y proyectos tecnológicos accesibles para nivel inicial, primario y secundario. Aprender haciendo, con software libre y recursos reutilizables.</p><div class="hero-actions"><a class="button" href="https://wa.me/541140488933?text=Hola%2C%20quisiera%20recibir%20informaci%C3%B3n%20sobre%20las%20propuestas%20educativas%20de%20REDRobot." target="_blank" rel="noreferrer">Quiero conocer las propuestas <span aria-hidden="true">↗</span></a><a class="text-link" href="#propuestas">Ver qué ofrecemos <span aria-hidden="true">↗</span></a></div><ul class="hero-proof" aria-label="Características principales"><li>Inicial, primario y secundario</li><li>Software libre</li><li>Recursos accesibles</li></ul></div><div class="hero-visual"><img src="/assets/redrobot-hero-v4-optimized.webp" srcset="/assets/redrobot-hero-v4-480.webp 480w, /assets/redrobot-hero-v4-768.webp 768w, /assets/redrobot-hero-v4-960.webp 960w, /assets/redrobot-hero-v4-optimized.webp 1254w" sizes="(max-width: 760px) 92vw, (max-width: 1100px) 48vw, 50vw" alt="Espacio educativo REDRobot con Otto Eyes, computadora, cuaderno de proyectos y estudiantes construyendo un robot" width="1254" height="1254" fetchpriority="high" decoding="async"/><p class="visual-note">RASPBERRY PI · SOFTWARE LIBRE · ROBÓTICA ABIERTA</p></div></section><section class="manifesto" id="proyecto"><p class="section-index">El proyecto</p><div class="manifesto-grid"><h2>Tecnología educativa<br/><em>al alcance de todos.</em></h2><div><p><span class="inline-brand" aria-label="REDRobot"><strong>RED</strong><span>Robot</span></span> nace de una idea concreta: no hace falta multiplicar equipos, licencias y plataformas para crear experiencias educativas valiosas. Hace falta elegir bien, reutilizar y compartir.</p><p>Nuestra misión es acercar tecnología, programación y robótica sin barreras económicas ni técnicas. Diseñamos proyectos prácticos, abiertos y replicables para el aula, un espacio comunitario o el hogar.</p></div></div><div class="values"><div><strong>ACCESIBLE</strong><span>Bajo costo, cero licencias innecesarias y compatibilidad con recursos existentes.</span></div><div><strong>ABIERTO</strong><span>Software libre, conocimiento compartido y libertad para modificar.</span></div><div><strong>REPLICABLE</strong><span>Proyectos simples de implementar, adaptar y volver a enseñar.</span></div></div></section><section class="audiences" id="propuestas" aria-labelledby="proposals-title"><div class="audiences-heading"><div><p class="section-index">Elegí tu punto de partida</p><h2 id="proposals-title">Una propuesta para <em>cada comunidad.</em></h2></div><p>Experiencias para estudiantes, herramientas para docentes y soluciones digitales para instituciones, con una misma forma de aprender haciendo.</p></div><div class="audience-grid"><article><img class="audience-image" src="/assets/redrobot-estudiantes.webp" srcset="/assets/redrobot-estudiantes-360.webp 360w, /assets/redrobot-estudiantes-640.webp 640w, /assets/redrobot-estudiantes.webp 1100w" sizes="(max-width: 760px) 92vw, (max-width: 1100px) 44vw, 33vw" alt="Dos estudiantes programando y construyendo un robot REDRobot" width="1100" height="1100" loading="lazy" decoding="async"/><div class="audience-body"><h3>Estudiantes</h3><p>Talleres y experiencias para descubrir la tecnología de forma activa, creativa y acompañada.</p><a href="https://wa.me/541140488933?text=Hola%2C%20soy%20estudiantes%20y%20quisiera%20conocer%20las%20propuestas%20de%20REDRobot." target="_blank" rel="noreferrer">Quiero saber más <span aria-hidden="true">↗</span></a></div></article><article><img class="audience-image" src="/assets/redrobot-docentes.webp" srcset="/assets/redrobot-docentes-360.webp 360w, /assets/redrobot-docentes-640.webp 640w, /assets/redrobot-docentes.webp 1100w" sizes="(max-width: 760px) 92vw, (max-width: 1100px) 44vw, 33vw" alt="Equipo docente planificando una actividad educativa con robótica" width="1100" height="1100" loading="lazy" decoding="async"/><div class="audience-body"><h3>Docentes</h3><p>Capacitación, recursos y propuestas listas para adaptar a distintos niveles y contextos.</p><a href="https://wa.me/541140488933?text=Hola%2C%20soy%20docentes%20y%20quisiera%20conocer%20las%20propuestas%20de%20REDRobot." target="_blank" rel="noreferrer">Quiero saber más <span aria-hidden="true">↗</span></a></div></article><article><img class="audience-image" src="/assets/redrobot-instituciones.webp" srcset="/assets/redrobot-instituciones-360.webp 360w, /assets/redrobot-instituciones-640.webp 640w, /assets/redrobot-instituciones.webp 1100w" sizes="(max-width: 760px) 92vw, (max-width: 1100px) 44vw, 33vw" alt="Equipo de una institución educativa analizando procesos y herramientas digitales" width="1100" height="1100" loading="lazy" decoding="async"/><div class="audience-body"><h3>Instituciones</h3><p>Educación digital, capacitación y mejora de procesos para transformar la experiencia de toda la comunidad educativa.</p><a href="#instituciones">Ver soluciones para institutos <span aria-hidden="true">↗</span></a></div></article></div></section><section class="platform" id="plataforma"><div class="platform-intro"><div><p class="section-index light">La plataforma</p><h2>Una Raspberry Pi.<br/><em>Muchos caminos.</em></h2></div><div class="platform-video-wrap"><div class="lazy-video-shell"><video class="platform-video" src="/assets/raspberrypi-v2-optimized.mp4" autoplay muted loop playsinline preload="metadata"></video></div><div class="platform-video-brand" aria-label="REDRobot"><span class="brand-lockup" aria-label="REDRobot, n guion bajo n"><span class="brand-name"><strong>RED</strong><span>Robot</span></span><span class="brand-code"><i>&lt;[</i><span class="brand-code-inner">n_n</span><i>]&gt;</i></span></span></div></div></div><div class="principle-grid"><article><span>IMPACTO</span><h3>Más impacto, menos costo</h3><p>Diseñamos cada propuesta para aprovechar hardware accesible y recursos que la institución ya posee. Así se pueden crear experiencias educativas valiosas sin depender de computadoras nuevas, licencias costosas ni equipamiento exclusivo.</p></article><article><span>COMPATIBILIDAD</span><h3>Si funciona en Raspberry Pi, funciona en más equipos</h3><p>Los proyectos se desarrollan originalmente para ser compatibles con Raspberry Pi. Esa eficiencia permite implementarlos también en computadoras antiguas o de prestaciones básicas, ampliando las posibilidades sin aumentar la inversión.</p></article><article><span>APRENDIZAJE</span><h3>Tecnología que se entiende y se reutiliza</h3><p>Priorizamos software libre, herramientas multiplataforma y sólo lo necesario. Una misma base puede acompañar programación, robótica y proyectos STEAM progresivos, adaptándose a los equipos disponibles en cada comunidad.</p></article></div></section><section class="otto" id="otto"><div class="otto-copy"><p class="section-index">Otto Eyes</p><h2>Un robot para<br/>aprender <em>sin miedo.</em></h2><p>Otto es la cara visible de <span class="inline-brand" aria-label="REDRobot"><strong>RED</strong><span>Robot</span></span> y también una puerta de entrada a la robótica. Su diseño abierto permite construirlo, programarlo, comprender cómo se mueve y transformarlo en nuevos proyectos.</p><p>No es un juguete cerrado: es un compañero de aprendizaje que conecta código, electrónica, diseño, creatividad y resolución de problemas.</p><p>Se construye con piezas impresas en 3D, una placa compatible con Arduino, servomotores, sensores y componentes electrónicos económicos y fáciles de conseguir. Sus conexiones son directas: no requiere soldadura ni experiencia previa. Recomendado desde los 8 años con acompañamiento adulto; a partir de los 12, puede abordarse con mayor autonomía.</p></div><div class="otto-video-wrap"><div class="lazy-video-shell"><video class="otto-video" src="/assets/otto-eyes-ensamblaje-optimized.mp4" autoplay muted loop playsinline preload="metadata"></video></div><div class="otto-video-brand" aria-label="REDRobot"><span class="brand-lockup" aria-label="REDRobot, n guion bajo n"><span class="brand-name"><strong>RED</strong><span>Robot</span></span><span class="brand-code"><i>&lt;[</i><span class="brand-code-inner">n_n</span><i>]&gt;</i></span></span></div></div></section><section class="social-proof" id="novedades" aria-labelledby="social-proof-title" hidden>
  <div class="social-proof-heading">
    <div>
      <p class="section-index">Lo último en REDRobot</p>
      <h2 id="social-proof-title">Seguimos aprendiendo,<br/><em>probando y compartiendo.</em></h2>
    </div>
    <div class="social-proof-intro">
      <p>Ideas, proyectos y herramientas para aprender haciendo. Una selección automática de nuestras publicaciones más recientes.</p>
      <a class="text-link" href="https://www.instagram.com/redrobot.educacion/" target="_blank" rel="noreferrer">Seguir @redrobot.educacion <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="instagram-grid" id="instagramGrid" aria-live="polite"></div>
</section><section class="institutions" id="instituciones" aria-labelledby="institutions-title"><div class="institutions-intro"><div><p class="section-index light">Para instituciones educativas</p><h2 id="institutions-title">Una institución más <em>conectada, ágil y preparada.</em></h2></div><div class="institutions-summary"><p><span class="inline-brand inline-brand-inverse" aria-label="REDRobot"><strong>RED</strong><span>Robot</span></span> no sólo lleva tecnología al aula. Acompaña a institutos educativos a mejorar sus propuestas digitales y a transformar procesos internos con soluciones simples, sostenibles y pensadas para su realidad.</p><strong>Mejor experiencia para estudiantes y docentes. Menos carga operativa para la institución.</strong></div></div><div class="institutional-grid"><article><h3>Propuesta educativa</h3><p>Diseñamos proyectos, talleres y experiencias tecnológicas que enriquecen la enseñanza y acercan nuevas herramientas a estudiantes y docentes.</p></article><article><h3>Ecosistema Google</h3><p>Integramos Classroom, Drive, Documentos, Formularios y Hojas de cálculo para organizar contenidos, colaborar y conectar la información del instituto.</p></article><article><h3>Digitalización y automatización</h3><p>Simplificamos inscripciones, seguimiento, asistencia, comunicaciones y reportes para reducir tareas repetitivas y recuperar tiempo de gestión.</p></article></div><div class="institutions-cta"><p>Empezamos por escuchar cómo trabaja hoy tu institución y dónde la tecnología puede generar más valor.</p><a class="button button-white" href="https://wa.me/541140488933?text=Hola%2C%20quisiera%20recibir%20informaci%C3%B3n%20sobre%20las%20propuestas%20educativas%20de%20REDRobot." target="_blank" rel="noreferrer">Conversemos sobre tu instituto <span aria-hidden="true">↗</span></a></div></section><section class="contact contact-with-form" id="contacto"><div><p class="section-index light">Conversemos</p><h2>¿Creamos algo<br/><em>juntos?</em></h2><div class="contact-copy"><p>Si sos parte de una institución, docente o familia, contanos qué nivel educativo y qué tipo de experiencia buscás. Te orientamos sin compromiso.</p><ol class="contact-steps"><li><strong>Contanos tu necesidad</strong><span>Nivel, cantidad de participantes y objetivo.</span></li><li><strong>Recibí una orientación</strong><span>Evaluamos una propuesta posible para tu contexto.</span></li></ol></div></div><form id="contactForm" class="contact-form">
        <h3>Contanos qué necesitás</h3>
        <label>Nombre<input required name="nombre" autocomplete="name" placeholder="Tu nombre" /></label>
        <label>Email<input required type="email" name="email" autocomplete="email" placeholder="tu@email.com" /></label>
        <label>Soy
          <select name="perfil" required>
            <option value="">Elegí una opción</option>
            <option>Docente</option><option>Institución</option><option>Familia</option><option>Otro</option>
          </select>
        </label>
        <label>¿En qué podemos ayudarte?<textarea required name="mensaje" rows="5" placeholder="Contanos brevemente qué estás buscando"></textarea></label>
        <button class="btn form-btn" type="submit">Enviar consulta por WhatsApp ↗</button>
        <p class="form-note">Al enviar, se abre WhatsApp con tu consulta lista para mandar.</p>
      </form></section><section class="creator" id="creador" aria-labelledby="creator-title"><div class="creator-avatar"><img src="/assets/lucas-walter-gonzalez.webp" srcset="/assets/lucas-walter-gonzalez-144.webp 144w, /assets/lucas-walter-gonzalez.webp 288w" sizes="144px" alt="Lic. Lucas Walter González, creador de REDRobot" width="288" height="288" loading="lazy" decoding="async"/></div><div class="creator-copy"><p class="section-index">CREADOR</p><h2 id="creator-title">Lic. Lucas Walter González</h2><p>Creador de <span class="inline-brand" aria-label="REDRobot"><strong>RED</strong><span>Robot</span></span>. Administración, educación y tecnología aplicadas para construir experiencias de aprendizaje accesibles y con impacto.</p></div><a class="creator-link" href="https://www.linkedin.com/in/lucas-walter-gonzalez" target="_blank" rel="noreferrer">Ver perfil en LinkedIn <span aria-hidden="true">↗</span></a></section><footer><a class="brand footer-brand" href="#inicio" aria-label="REDRobot, volver al inicio"><img class="animated-logo animated-logo-inverse" src="/assets/redrobot-logo-animado-oscuro.gif" alt="REDRobot" width="190" height="38" loading="lazy" decoding="async"/></a><p>Educación digital · Buenos Aires, Argentina</p><div class="social-links social-links-footer" aria-label="Redes sociales"><a href="https://www.instagram.com/redrobot.educacion/" target="_blank" rel="noreferrer" aria-label="REDRobot en Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle><circle class="social-dot" cx="17.4" cy="6.7" r="1"></circle></svg></a><a href="https://www.facebook.com/redrobot.educacion/" target="_blank" rel="noreferrer" aria-label="REDRobot en Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.2 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.1H8V13h2.8v8h3.4Z"></path></svg></a></div><p>© 2026 <span class="inline-brand inline-brand-inverse" aria-label="REDRobot"><strong>RED</strong><span>Robot</span></span></p></footer><a class="whatsapp-float" href="https://wa.me/541140488933?text=Hola%2C%20quisiera%20recibir%20informaci%C3%B3n%20sobre%20las%20propuestas%20educativas%20de%20REDRobot." target="_blank" rel="noreferrer" aria-label="Escribinos por WhatsApp" title="Escribinos por WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.5 4.1 1.6 5.9L.2 24l6.4-1.7a11.8 11.8 0 0 0 5.6 1.4h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.3-6.2-3.6-8.4Zm-8.3 18.2c-1.7 0-3.5-.5-5-1.4l-.4-.2-3.8 1 1-3.7-.2-.4a9.8 9.8 0 1 1 8.4 4.7Zm5.4-7.3c-.3-.1-1.8-.9-2.1-1-.3-.1-.5-.1-.7.2-.2.3-.8 1-.9 1.2-.2.2-.4.2-.7.1-1.8-.9-3-1.6-4.2-3.6-.3-.6.3-.5.9-1.8.1-.2 0-.4 0-.6l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 2.9s1.2 3.3 1.4 3.5c.2.2 2.4 3.7 5.9 5.2.8.4 1.5.6 2 .7.8.3 1.6.2 2.2.1.7-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4Z"></path></svg></a></main>
<script is:inline>
    const form = document.getElementById('contactForm');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const nombre = String(data.get('nombre') || '').trim();
      const email = String(data.get('email') || '').trim();
      const perfil = String(data.get('perfil') || '').trim();
      const mensaje = String(data.get('mensaje') || '').trim();
      const texto = [
        'Hola REDRobot. Quisiera hacer una consulta.',
        '',
        'Nombre: ' + nombre,
        'Email: ' + email,
        'Soy: ' + perfil,
        '',
        'Consulta: ' + mensaje
      ].join('\n');
      const url = 'https://wa.me/5491140488933?text=' + encodeURIComponent(texto);
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  </script>

<script is:inline>
  (() => {
    const section = document.getElementById('novedades');
    const grid = document.getElementById('instagramGrid');
    if (!section || !grid) return;

    const escapeHtml = (value = '') => String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

    const labelFor = (post) => {
      if (post.media_type === 'VIDEO' || post.media_type === 'REELS') return 'REEL';
      if (post.media_type === 'CAROUSEL_ALBUM') return 'CARRUSEL';
      return 'PUBLICACIÓN';
    };

    const render = (posts, preview = false) => {
      grid.innerHTML = posts.slice(0, 3).map((post) => {
        const image = escapeHtml(post.thumbnail_url || post.media_url || '');
        const permalink = escapeHtml(post.permalink || 'https://www.instagram.com/redrobot.educacion/');
        const caption = escapeHtml((post.caption || 'Nueva publicación de REDRobot').trim());
        const excerpt = caption.length > 118 ? caption.slice(0, 115).trimEnd() + '…' : caption;
        const badge = preview ? 'VISTA PREVIA' : labelFor(post);
        return `<article class="instagram-card">
          <a class="instagram-media" href="${permalink}" target="_blank" rel="noreferrer" aria-label="Abrir publicación en Instagram">
            <img src="${image}" alt="" loading="lazy" decoding="async" />
            <span class="instagram-badge">${badge}</span>
          </a>
          <div class="instagram-copy">
            <p>${excerpt}</p>
            <a href="${permalink}" target="_blank" rel="noreferrer">Ver en Instagram <span aria-hidden="true">↗</span></a>
          </div>
        </article>`;
      }).join('');
      if (grid.children.length) section.hidden = false;
    };

    const previewPosts = [
      {media_type:'CAROUSEL_ALBUM', media_url:'/assets/redrobot-docentes.webp', caption:'Herramientas y recursos para transformar un apunte en una experiencia de aprendizaje.', permalink:'https://www.instagram.com/redrobot.educacion/'},
      {media_type:'VIDEO', media_url:'/assets/redrobot-hero-v4-optimized.webp', caption:'Proyectos reales para aprender tecnología haciendo, probando y construyendo.', permalink:'https://www.instagram.com/redrobot.educacion/'},
      {media_type:'IMAGE', media_url:'/assets/redrobot-estudiantes.webp', caption:'Robótica, programación y creatividad con recursos accesibles y software libre.', permalink:'https://www.instagram.com/redrobot.educacion/'}
    ];

    fetch('/api/instagram', {headers:{accept:'application/json'}})
      .then(async (response) => {
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !Array.isArray(data.posts) || !data.posts.length) throw new Error(data.error || 'Instagram no configurado');
        render(data.posts);
      })
      .catch(() => {
        if (location.hostname.endsWith('.vercel.app')) render(previewPosts, true);
      });
  })();
</script>
</body>
</html>
