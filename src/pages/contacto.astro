---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contacto" description="Contacto con REDRobot para docentes, instituciones y proyectos educativos.">
  <section class="contact-wrap">
    <div class="intro"><p class="eyebrow">CONTACTO</p><h1>Hablemos de educación y tecnología.</h1><p>Si sos docente, institución, estudiante o querés proponer una colaboración, podés escribirnos y contarnos qué necesitás.</p></div>
    <div class="panel">
      <div><span>01</span><h2>Docentes</h2><p>Consultas sobre actividades, materiales y adaptación de proyectos al aula.</p></div>
      <div><span>02</span><h2>Instituciones</h2><p>Talleres, implementación y propuestas educativas personalizadas.</p></div>
      <div><span>03</span><h2>Comunidad</h2><p>Ideas, mejoras, proyectos derivados y aportes abiertos.</p></div>
    </div>
    <div class="direct"><div><p class="eyebrow">CANAL DIRECTO</p><h2>Lucas Walter González</h2><p>Creador de REDRobot</p></div><div class="actions"><a class="btn btn-primary" href="mailto:contacto@redrobot.ar">contacto@redrobot.ar</a><a class="github" href="https://github.com/LucasWGonzalez/redrobot-site" target="_blank">GitHub →</a></div></div>
  </section>
<style>
.eyebrow{font-size:12px;font-weight:700;letter-spacing:.15em;color:var(--color-red);margin-bottom:16px}.contact-wrap{padding:50px 0}.intro{max-width:850px;padding-bottom:60px}.intro h1{font-size:64px;letter-spacing:-.04em}.intro>p:last-child{font-size:21px}.panel{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #ddd;border-bottom:1px solid #ddd}.panel>div{padding:38px 34px;min-height:270px;border-right:1px solid #ddd}.panel>div:last-child{border-right:0}.panel span{font-family:monospace;font-weight:700;color:var(--color-red)}.panel h2{margin-top:55px}.direct{margin-top:80px;background:var(--color-light);padding:48px;display:flex;justify-content:space-between;align-items:center;gap:30px}.direct h2{font-size:38px}.actions{display:flex;align-items:center;gap:24px}.github{font-weight:700;color:var(--color-dark)}@media(max-width:760px){.intro h1{font-size:46px}.panel{grid-template-columns:1fr}.panel>div{border-right:0;border-bottom:1px solid #ddd}.panel>div:last-child{border-bottom:0}.direct,.actions{align-items:flex-start;flex-direction:column}}
</style>
</Layout>