---
import '../styles/variables.css';
interface Props { title: string; description?: string; }
const { title, description = 'Educación digital creativa, libre y colaborativa' } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} | REDRobot</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="header-inner">
      <a class="logo" href="#inicio"><strong>RED</strong>Robot <span>&lt;[n_n]&gt;</span></a>
      <nav>
        <a href="#proyecto">Qué es</a><a href="#propuestas">Propuestas</a><a href="#instituciones">Instituciones</a><a href="#plataforma">Plataforma</a>
      </nav>
      <a class="consult" href="#contacto">Consultanos ↗</a>
    </div>
  </header>
  <main><slot /></main>
  <footer>
    <div class="footer-inner"><div class="logo"><strong>RED</strong>Robot <span>&lt;[n_n]&gt;</span></div><small>EDUCACIÓN DIGITAL · BUENOS AIRES, ARGENTINA</small><small>© 2026 REDRobot</small></div>
  </footer>
  <style is:global>
    html{scroll-behavior:smooth}body{margin:0}.site-header{position:sticky;top:0;z-index:50;background:#f7f5f0ee;backdrop-filter:blur(10px);border-bottom:1px solid #dedbd4}.header-inner,.footer-inner{max-width:1180px;margin:auto;padding:15px 28px;display:flex;align-items:center;gap:28px}.logo{font-weight:700;color:#191919;text-decoration:none;white-space:nowrap}.logo strong{color:#e62227}.logo span{font-family:monospace;color:#e62227;font-size:.85em}.site-header nav{display:flex;gap:25px;margin-left:auto}.site-header nav a{font-size:11px;font-weight:700;color:#191919;text-decoration:none}.consult{background:#e62227;color:#fff;text-decoration:none;font-size:11px;font-weight:800;padding:11px 15px}footer{background:#191919;color:#fff}.footer-inner{min-height:68px}.footer-inner small{font-size:9px;letter-spacing:.08em;color:#aaa}.footer-inner small:last-child{margin-left:auto}@media(max-width:760px){.header-inner{flex-wrap:wrap}.site-header nav{order:3;width:100%;overflow:auto;gap:18px;margin:0}.consult{margin-left:auto}.footer-inner{flex-wrap:wrap}.footer-inner small:last-child{margin-left:0}}
  </style>
</body>
</html>